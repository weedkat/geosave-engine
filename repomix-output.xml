from __future__ import annotations

from typing import ClassVar, Mapping

import torch
import torch.nn as nn
import torch.nn.functional as F

from affine import Affine

from geosave_engine.ml.inference.sliding_window import sliding_window_inference
from geosave_engine.ml.models.contract import (
    GeoContext,
    RasterInput,
    RasterPyramid,
    RasterMap,
    RasterOutput,
    RasterEncoderPyramid,
    RasterDecoder,
    RasterHead,
)
from geosave_engine.ml.models.encoder.dinov3 import DINOv3
from geosave_engine.ml.models.decoder.dpt import DPTDecoder
from geosave_engine.ml.models.decoder.unet import UnetDecoder
from geosave_engine.ml.models.head.dense import DenseHead


class BaseModule(nn.Module):
    """Shared init wiring for encoder -> decoder -> head segmentation tasks.

    Subclasses must define ``ENCODERS`` and a ``forward`` method.

    Args:
        encoder: ``ENCODERS`` key or module class satisfying ``RasterEncoderPyramid``.
        decoder: ``DECODERS`` key or module class satisfying ``RasterDecoder``.
        head: ``HEADS`` key or module class satisfying ``RasterHead``.
        in_channels: input image channel count (forwarded to encoder).
        num_classes: number of output classes (forwarded to head).
        input_size: spatial patch size used by ``forward_sliding``.
        encoder_config: extra encoder construction kwargs.
        decoder_config: decoder hyperparameter overrides.
        head_config: head hyperparameter overrides.
    """

    ENCODERS: ClassVar[dict[str, type[nn.Module]]] = {}
    DECODERS: ClassVar[dict[str, type[nn.Module]]] = {
        'dpt': DPTDecoder,
        'unet': UnetDecoder,
    }
    HEADS: ClassVar[dict[str, type[nn.Module]]] = {
        'dense': DenseHead,
    }

    def __init__(
        self,
        encoder: str | type[nn.Module] = 'dinov3',
        decoder: str | type[nn.Module] = 'dpt',
        head: str | type[nn.Module] = 'dense',
        in_channels: int = 3,
        num_classes: int = 1,
        input_size: tuple[int, int] | int = (256, 256),
        encoder_config: Mapping[str, object] | None = None,
        decoder_config: Mapping[str, object] | None = None,
        head_config: Mapping[str, object] | None = None,
        upsample_output: bool = True,
    ):
        super().__init__()
        self.upsample_output = upsample_output
        self.input_size = (input_size, input_size) if isinstance(input_size, int) else input_size

        enc_cls = self.ENCODERS[encoder] if isinstance(encoder, str) else encoder
        enc = enc_cls(in_channels=in_channels, **dict(encoder_config or {}))
        if not isinstance(enc, RasterEncoderPyramid):
            raise TypeError(f"{type(enc).__name__} does not satisfy RasterEncoderPyramid")
        self.encoder: RasterEncoderPyramid = enc

        dec_cls = self.DECODERS[decoder] if isinstance(decoder, str) else decoder
        dec = dec_cls(
            encoder_out_channels=enc.out_channels,
            encoder_output_strides=enc.output_strides,
            **dict(decoder_config or {}),
        )
        if not isinstance(dec, RasterDecoder):
            raise TypeError(f"{type(dec).__name__} does not satisfy RasterDe22coder")
        self.decoder: RasterDecoder = dec

        hd_cls = self.HEADS[head] if isinstance(head, str) else head
        hd = hd_cls(in_channels=dec.out_channels, num_classes=num_classes, **dict(head_config or {}))
        if not isinstance(hd, RasterHead):
            raise TypeError(f"{type(hd).__name__} does not satisfy RasterHead")
        self.head: RasterHead = hd


class SemanticSegmentation(BaseModule):
    """Plain tensor segmentation: encoder -> decoder -> head.

    No geo context. Compatible with any ``RasterEncoderPyramid`` encoder.
    """

    ENCODERS: ClassVar[dict[str, type[nn.Module]]] = {
        'dinov3': DINOv3,
    }

    def forward(self, tensor: torch.Tensor) -> RasterOutput:
        """Run encoder -> decoder -> head; upsample logits to input size.

        Args:
            tensor: Float image ``[B, C, H, W]``.

        Returns:
            ``RasterOutput`` with logits ``[B, num_classes, H, W]``.
        """
        input = RasterInput(tensor=tensor)
        pyramid: RasterPyramid = self.encoder.forward_raster_pyramid(input)
        rmap: RasterMap = self.decoder.forward_raster(pyramid)
        output: RasterOutput = self.head.forward_raster(rmap)
        h, w = tensor.shape[-2:]
        if output.tensor.shape[-2:] != (h, w) and self.upsample_output:
            logits = F.interpolate(output.tensor, size=(h, w), mode='bilinear', align_corners=False)
            output = RasterOutput(tensor=logits)
        return output

    def forward_sliding(
        self,
        tensor: torch.Tensor,
        overlap_ratio: float = 0.5,
        pad_size: int = 64,
    ) -> RasterOutput:
        """Sliding-window inference over a large raster with Hann blending.

        Args:
            tensor: Full-resolution float image ``[B, C, H, W]``.
            overlap_ratio: Patch overlap fraction. Must be in ``[0, 1)``.
            pad_size: Reflect-padding added on each side before patching.

        Returns:
            ``RasterOutput`` with blended logits ``[B, num_classes, H, W]``.
        """
        def model_fn(patch: torch.Tensor) -> torch.Tensor:
            return self.forward(patch).tensor

        result = sliding_window_inference(model_fn, tensor, self.input_size, overlap_ratio, pad_size)
        return RasterOutput(tensor=result)


class GeoSemanticSegmentation(BaseModule):
    """Geo-aware segmentation: encoder -> decoder -> head with geospatial context.

    Passes CRS, transform, and timestamps through the pipeline via ``GeoContext``.
    Use this task when encoders consume geo metadata (e.g. Prithvi).
    """

    ENCODERS: ClassVar[dict[str, type[nn.Module]]] = {
        'dinov3': DINOv3,
        # add geo-native encoders here (e.g. 'prithvi': Prithvi)
    }

    def forward(
        self,
        tensor: torch.Tensor,
        crs: list[str] | None = None,
        coordinate: list[tuple[float, float]] | None = None,
        transform: list[Affine] | None = None,
        time: list[object] | None = None,
    ) -> RasterOutput:
        """Run encoder -> decoder -> head with geo context; upsample to input size.

        Args:
            tensor: Float image ``[B, C, H, W]``.
            crs: Per-sample CRS strings. Length = B.
            transform: Per-sample affine transforms. Length = B.
            time: Per-sample timestamps or labels. Length = B.

        Returns:
            ``RasterOutput`` with logits ``[B, num_classes, H, W]`` and geo context.
        """
        context = GeoContext(crs=crs, coordinate=coordinate, transform=transform, time=time)
        input = RasterInput(tensor=tensor, context=context)
        pyramid: RasterPyramid = self.encoder.forward_raster_pyramid(input)
        rmap: RasterMap = self.decoder.forward_raster(pyramid)
        output: RasterOutput = self.head.forward_raster(rmap)
        h, w = tensor.shape[-2:]
        if output.tensor.shape[-2:] != (h, w) and self.upsample_output:
            logits = F.interpolate(output.tensor, size=(h, w), mode='bilinear', align_corners=False)
            output = RasterOutput(tensor=logits, context=output.context)
        return output

    def forward_sliding(
        self,
        tensor: torch.Tensor,
        crs: list[str] | None = None,
        coordinate: list[tuple[float, float]] | None = None,
        transform: list[Affine] | None = None,
        time: list[object] | None = None,
        overlap_ratio: float = 0.5,
        pad_size: int = 64,
    ) -> RasterOutput:
        """Sliding-window inference over a large raster with Hann blending.

        Geo context is passed to each patch call unchanged — suitable when
        encoder uses metadata for conditioning but not for spatial alignment.

        Args:
            tensor: Full-resolution float image ``[B, C, H, W]``.
            crs: Per-sample CRS strings. Length = B.
            coordinate: Per-sample centroid coordinates in (lon, lat) order. Length = B.
            transform: Per-sample affine transforms. Length = B.
            time: Per-sample timestamps or labels. Length = B.
            overlap_ratio: Patch overlap fraction. Must be in ``[0, 1)``.
            pad_size: Reflect-padding added on each side before patching.

        Returns:
            ``RasterOutput`` with blended logits ``[B, num_classes, H, W]`` and geo context.
        """
        def model_fn(patch: torch.Tensor) -> torch.Tensor:
            return self.forward(patch, crs=crs, coordinate=coordinate, transform=transform, time=time).tensor

        result = sliding_window_inference(model_fn, tensor, self.input_size, overlap_ratio, pad_size)
        context = GeoContext(crs=crs, coordinate=coordinate, transform=transform, time=time)
        return RasterOutput(tensor=result, context=context)


if __name__ == "__main__":
    # Example usage
    encoder_config = {'pretrained': False}
    model = SemanticSegmentation(encoder='dinov3', decoder='dpt', head='dense', in_channels=3, num_classes=5, encoder_config=encoder_config)
    input_tensor = torch.randn(2, 3, 256, 256)  # Batch of 2 RGB images
    output = model.forward(input_tensor)
    print(output.tensor.shape)  # Should be [2, 5, 256, 256]
