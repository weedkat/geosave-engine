dynamic = ["version"]
description = 'Library for geospatial machine learning, focusing providing pretrained model, and uploading map collection to geosave-app'
readme = "README.md"
requires-python = ">=3.12"
license = "MIT"
keywords = []
authors = [
  { name = "Fatah Muria", email = "fatahmurbaut@gmail.com" },
]

classifiers = [
  "Development Status :: 3 - Alpha",
  "Intended Audience :: Science/Research",
  "Programming Language :: Python :: 3",
  "Topic :: Scientific/Engineering :: Image Recognition",
]

dependencies = [
    "gdown>=5.2.2",
    "geopandas>=0.14.0",
    "scipy>=1.11.0",
    "lightning>=2.3.3",
    "matplotlib>=3.7.5",
