[project.urls]
Documentation = "https://github.com/Fatah Muria/geosave-engine#readme"
Issues = "https://github.com/Fatah Muria/geosave-engine/issues"
Source = "https://github.com/Fatah Muria/geosave-engine"

[project.scripts]
geosave = "geosave_engine.cli.main:app"

[tool.hatch.version]
path = "src/geosave_engine/__about__.py"

[tool.hatch.build.targets.wheel]
packages = ["src/geosave_engine"]

[tool.hatch.build.targets.wheel.force-include]
"src/geosave_engine/ml/models/encoder/configs/metadata.yaml" = "geosave_engine/ml/models/encoder/configs/metadata.yaml"

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
addopts = ["--import-mode=importlib", "-m", "not slow and not integration"]
