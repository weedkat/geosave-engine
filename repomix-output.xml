from __future__ import annotations

from typing import Callable, Literal
from typing_extensions import Self

import pystac
import xarray as xr

from geosave_engine.geodata.stac import StacClient
from geosave_engine.geodata.stac.query import StacQuery
from geosave_engine.utils.geodata import extract_raster_scale_offset
from geosave_engine.utils.stac_query import CQL2

from .base import BaseSource, CompositeMode, SlotMode


def preprocess_sentinel2(ds: xr.Dataset, items: list[pystac.Item]) -> xr.Dataset:
    """Apply radiometric scaling to Sentinel-2 bands using item metadata."""
    scale, offset = extract_raster_scale_offset(items[0])
    return ds * scale + offset


class Sentinel2(BaseSource):
    """Sentinel-2 source with radiometric preprocessing by default."""

    def __init__(
        self,
        client: StacClient,
        *,
        n_slots: int = 1,
        slot_mode: SlotMode = "daily",
        composite: CompositeMode = "nearest",
        preprocess: Callable[[xr.Dataset, list[pystac.Item]], xr.Dataset] | None = None,
        max_nodata_fraction: float = 0.0,
        resampling: str = "bilinear",
        groupby: Literal["time", "solar_day", "id"] = "solar_day",
        chunks: dict[str, int | Literal["auto"]] | None = None,
        dtype: str = "float32",
        preserve_original_order: bool | None = None,
    ) -> None:
        super().__init__(
            client,
            n_slots=n_slots,
            slot_mode=slot_mode,
            composite=composite,
            preprocess=preprocess or preprocess_sentinel2,
            max_nodata_fraction=max_nodata_fraction,
            resampling=resampling,
            groupby=groupby,
            chunks=chunks,
            dtype=dtype,
            preserve_original_order=preserve_original_order,
        )
    
    def max_cloud_cover(self, max_cover: float) -> Self:
        """Filter scenes with cloud cover above ``max_cover`` percent.

        Args:
            max_cover: Maximum allowed cloud cover (0–100).
        """
        self.query.with_filter(CQL2.lte("eo:cloud_cover", max_cover))
        return self

    def max_snow_cover(self, max_cover: float) -> Self:
        """Filter scenes with snow cover above ``max_cover`` percent.

        Args:
            max_cover: Maximum allowed snow cover (0–100).
        """
        self.query.with_filter(CQL2.lte("eo:snow_cover", max_cover))
        return self

    def min_sun_elevation(self, min_elev: float) -> Self:
        """Filter scenes with sun elevation below ``min_elev`` degrees.

        Args:
            min_elev: Minimum sun elevation angle in degrees. Low values → long shadows.
        """
        self.query.with_filter(CQL2.gte("view:sun_elevation", min_elev))
        return self

    def platform(self, name: Literal["sentinel-2a", "sentinel-2b"]) -> Self:
        """Filter to a specific Sentinel-2 platform.

        Args:
            name: ``'sentinel-2a'`` or ``'sentinel-2b'``.
        """
        self.query.with_filter(CQL2.eq("platform", name))
        return self

    def relative_orbit(self, orbit: int) -> Self:
        """Filter by relative orbit number for consistent viewing geometry.

        Args:
            orbit: Relative orbit number (1–143 for Sentinel-2).
        """
        self.query.with_filter(CQL2.eq("sat:relative_orbit", orbit))
        return self

    def sortby_cloud_cover(self, direction: str = "asc") -> Self:
        """Sort results by cloud cover to prioritize clearer scenes.

        Args:
            direction: ``'asc'`` (clearest first) or ``'desc'``.
        """
        self.query.with_sortby("eo:cloud_cover", direction)
        return self


class Sentinel2L2A(Sentinel2):
    """Sentinel-2 L2A (surface reflectance). Scales DN to reflectance via item metadata.

    Args:
        client: STAC client (use ``StacClient.cdse()`` for Copernicus).
        n_slots: Number of time slots to return.
        slot_mode: Temporal grouping per slot (``'daily'``, ``'weekly'``, ``'monthly'``, ``'yearly'``, ``'per_scene'``).
        composite: Reduce strategy within slot. ``'nearest'``/``'latest'`` pick one scene; ``'mean'``/``'median'`` aggregate all.
        preprocess: Custom transform applied after load. Defaults to radiometric scaling.
        max_nodata_fraction: Reject tiles where nodata fraction exceeds this (0–1).
        resampling: Resampling method passed to odc-stac.
        groupby: How odc-stac groups scenes along time axis.
        chunks: Dask chunk sizes. Defaults to ``{'x': 1024, 'y': 1024}``.
        dtype: Output dtype.
        preserve_original_order: Preserve STAC item order in time axis.

    Examples:
        >>> client = StacClient.cdse()
        >>> src = Sentinel2L2A(
        ...     client,
        ...     n_slots=3,
        ...     slot_mode="monthly",
        ...     composite="median",
        ...     max_nodata_fraction=0.1,
        ... )
        >>> src.max_cloud_cover(20).max_snow_cover(10).sortby_cloud_cover()
        >>> tile = src.load(anchor, bands=["B02", "B03", "B04", "B08"])
    """

    def _default_query(self) -> StacQuery:
        return StacQuery(collections=["sentinel-2-l2a"])


class Sentinel2L1C(Sentinel2):
    """Sentinel-2 L1C (top-of-atmosphere radiance). No atmospheric correction applied.

    Args:
        client: STAC client (use ``StacClient.cdse()`` for Copernicus).
        n_slots: Number of time slots to return.
        slot_mode: Temporal grouping per slot (``'daily'``, ``'weekly'``, ``'monthly'``, ``'yearly'``, ``'per_scene'``).
        composite: Reduce strategy within slot. ``'nearest'``/``'latest'`` pick one scene; ``'mean'``/``'median'`` aggregate all.
        preprocess: Custom transform applied after load. Defaults to radiometric scaling.
        max_nodata_fraction: Reject tiles where nodata fraction exceeds this (0–1).
        resampling: Resampling method passed to odc-stac.
        groupby: How odc-stac groups scenes along time axis.
        chunks: Dask chunk sizes. Defaults to ``{'x': 1024, 'y': 1024}``.
        dtype: Output dtype.
        preserve_original_order: Preserve STAC item order in time axis.

    Examples:
        >>> client = StacClient.cdse()
        >>> src = Sentinel2L1C(client, slot_mode="daily", composite="nearest")
        >>> src.max_cloud_cover(15).platform("sentinel-2a").sortby_cloud_cover()
        >>> tile = src.load(anchor, bands=["B01", "B09", "B10"])
    """

    def _default_query(self) -> StacQuery:
        return StacQuery(collections=["sentinel-2-l1c"])
