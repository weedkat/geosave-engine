<file path="src/geosave_engine/ml/models/contract/raster.py">
import torch

from typing import Protocol, runtime_checkable
from dataclasses import dataclass, field
from affine import Affine

@dataclass(frozen=True)
class Context:
    """Base class for data context"""

@dataclass(frozen=True)
class GeoContext(Context):
    """Geospatial metadata attached to every tensor flowing through the pipeline.

    Attributes:
        crs: per-sample CRS strings, e.g. ``["EPSG:4326", ...]``. Length = B.
        coordinate: per-sample centroid coordinates in (lon, lat) order. Length = B.
        transform: per-sample affine transforms mapping pixel indices to world
            coordinates. Length = B.
        time: per-sample timestamps or any time label. Length = B.
        nodata_mask: ``(B, 1, H, W)`` bool tensor; ``True`` where pixels are
            invalid (nodata). Matches the spatial resolution of the paired tensor.
    """

    crs: list[str] | None
    coordinate: list[tuple[float, float]] | None
    transform: list[Affine] | None
    time: list[object] | None
    nodata_mask: torch.Tensor | None = None


@dataclass(frozen=True)
class RasterFeatures:
    """Base class for all feature tensors flowing between pipeline stages.

    Every intermediate result carries the originating geospatial context so
    downstream stages (e.g. loss functions, postprocessing) can reference CRS,
    transform, and nodata information without passing it separately.
    """

    context: Context | None = field(default=None, kw_only=True)


@dataclass(frozen=True)
class RasterInput(RasterFeatures):
    """Raw raster entering the pipeline.

    Attributes:
        tensor: ``(B, C, H, W)`` float image tensor. ``C`` is the number of
            input bands (e.g. 3 for RGB, 12 for Sentinel-2 all bands).
        context: geospatial metadata for the batch.
    """

    tensor: torch.Tensor


@dataclass(frozen=True)
class RasterPyramid(RasterFeatures):
    """Multi-scale feature pyramid produced by an encoder or neck.

    Levels are ordered **fine-to-coarse**: index 0 is the highest spatial
    resolution. Each level ``i`` has shape ``(B, C_i, H / s_i, W / s_i)``
    where ``s_i`` is the spatial stride at that scale.

    Attributes:
        tensor: one feature map per scale; ``len(tensor)`` == number of levels.
        prefix_token: per-level prefix tokens ``(B, N, C_i)`` from ViT encoders
            (CLS + register tokens). Aligned with ``tensor`` by index. ``None``
            if the encoder does not produce prefix tokens.
        context: geospatial metadata carried from the input.
    """

    tensor: list[torch.Tensor]
    prefix_token: list[torch.Tensor] | None = None


@dataclass(frozen=True)
class RasterMap(RasterFeatures):
    """Single dense spatial feature map produced by a decoder.

    Attributes:
        tensor: ``(B, C, H, W)``. ``H`` and ``W`` are typically a fraction of
            the input resolution (e.g. 1/2 or 1/4) before the task head
            upsamples back to input size.
        context: geospatial metadata carried from the input.
    """

    tensor: torch.Tensor


@dataclass(frozen=True)
class RasterOutput(RasterFeatures):
    """Final prediction produced by a head.

    Shape depends on the task:
    - Semantic segmentation / pixelwise regression: ``(B, num_classes, H, W)``
      upsampled to match the input spatial resolution.
    - Classification / global regression: ``(B, num_classes)``.

    Attributes:
        tensor: task-specific prediction tensor.
        context: geospatial metadata carried from the input.
    """

    tensor: torch.Tensor


@runtime_checkable
class RasterEncoderMap(Protocol):
    """Role: raster input -> single dense feature map.

    Suitable for CNN backbones that output a single spatial scale.

    Attributes:
        out_channels: channel width of the emitted feature map.
    """

    out_channels: int

    def forward_raster_map(self, input: RasterInput) -> RasterMap: ...


@runtime_checkable
class RasterEncoderPyramid(Protocol):
    """Role: raster input -> multi-scale feature pyramid.

    Suitable for ViT backbones (via intermediate features) and hierarchical CNNs.

    Attributes:
        out_channels: per-level channel counts, fine-to-coarse.
        output_strides: per-level spatial strides relative to input, fine-to-coarse.
    """

    out_channels: list[int]
    output_strides: list[int]

    def forward_raster_pyramid(self, input: RasterInput) -> RasterPyramid: ...


@runtime_checkable
class RasterDecoder(Protocol):
    """Role: feature pyramid -> single dense feature map.

    Fuses multi-scale features from an encoder into a single spatial map
    ready for a task head.

    Attributes:
        out_channels: channel width of the emitted dense map.

    Constructor convention (not enforced):
        Required init args:
            - encoder_out_channels: list[int]
            - encoder_output_strides: list[int]
    """

    out_channels: int

    def forward_raster(self, input: RasterPyramid) -> RasterMap: ...


@runtime_checkable
class RasterHead(Protocol):
    """Role: dense feature map -> task output. Terminal stage.

    Applies task-specific projection (segmentation logits, regression values,
    classification scores) and produces ``RasterOutput``.

    Constructor convention (not enforced):
        Required init args:
            - in_channels: int
            - num_classes: int
    """

    def forward_raster(self, input: RasterMap) -> RasterOutput: ...
