    "rioxarray>=0.15.0",
    "rasterio>=1.3.11",
    "stackstac>=0.5.0",
    "xarray>=2023.1.0",
    "zarr>=3.0.0",
    "python-dotenv>=1.0.1",
    "pyproj>=3.6.0",
    "pyyaml>=6.0.3",
    "questionary>=2.1.0",
    "rich>=13.7.1",
    "scikit-learn>=1.3.2",
    "segmentation-models-pytorch>=0.3.3",
    "tensorboard>=2.14.0",
    "toml>=0.10.2",
    "torchgeo>=0.2.1",
    "typer>=0.20.1",
    "xformers>=0.0.28.post1",
    "tqdm>=4.67.3",
    "s2cloudless>=1.7.3",
    "odc-stac>=0.5.2",
    "boto3>=1.42.91",
    "odc-geo>=0.5.1",
    "geopy>=2.4.0",
    "albumentations>=2.0.8",
    "folium>=0.20.0",
    "mapclassify>=2.8.1",
    "kornia>=0.8.2",
    "wget>=3.2",
    "huggingface>=0.0.1",
    "huggingface-hub>=1.0.0",
    "transformers>=5.9.0",
    "terratorch>=1.2.7",
    "python-box>=7.0.0",
