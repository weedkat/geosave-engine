{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/weedkat/geosave-engine/main/schemas/geosave/v0.1.0/schema.json",
  "title": "GeoSave Extension",
  "description": "Fields GeoSave adds to a STAC Item.",
  "type": "object",
  "required": ["stac_extensions", "type", "properties"],
  "properties": {
    "type": {"const": "Feature"},
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://raw.githubusercontent.com/weedkat/geosave-engine/main/schemas/geosave/v0.1.0/schema.json"
      }
    },
    "properties": {
      "type": "object",
      "properties": {
        "geosave:stack": {
          "title": "Stack this Item was saved from, shared by its groups",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
